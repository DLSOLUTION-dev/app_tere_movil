# ── Base de datos PostgreSQL ──────────────────────────────────────────────────
DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/tere_movil"

# ── JWT ───────────────────────────────────────────────────────────────────────
# Genera una clave segura con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="cambia_esto_por_una_clave_larga_y_aleatoria"
JWT_EXPIRES_IN="7d"

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── CORS ──────────────────────────────────────────────────────────────────────
# Orígenes web permitidos, separados por coma.
# Déjalo vacío si solo usas la app móvil (no panel web).
# Ejemplo producción: CORS_ORIGIN=https://mi-panel.com
CORS_ORIGIN=

# ── Seed de base de datos ─────────────────────────────────────────────────────
# Contraseña del administrador inicial. Solo se usa al correr seed.js por primera vez.
ADMIN_SEED_PASSWORD="cambia_esto_por_una_contraseña_segura"

# ── Firebase (notificaciones push + Storage de imágenes) ──────────────────────
# Obtén estos valores desde la consola de Firebase:
# Configuración del proyecto → Cuentas de servicio → Generar nueva clave privada
# Bucket: Firebase Console → Storage → nombre del bucket (ej: mi-proyecto.appspot.com)
FIREBASE_PROJECT_ID=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_STORAGE_BUCKET=""
